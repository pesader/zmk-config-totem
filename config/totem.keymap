#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <locale/keys_pt_abnt2.h>

&lt {
    flavor = "balanced";
    tapping-term-ms = <300>;
    quick-tap-ms = <250>;
    require-prior-idle-ms = <50>;
};

&sk { quick-release; };

/ {
    behaviors {
        hrm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };
    };

    macros {
        os_focus_notification: os_dismiss_notification {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>;
            label = "OS_DISMISS_NOTIFICATION";
        };

        os_end_session: os_end_session {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(DELETE))>;
            label = "OS_END_SESSION";
        };

        os_lock_screen: os_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(BACKSPACE))>;
            label = "OS_LOCK_SCREEN";
        };

        txt_assignment: txt_assignment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp SPACE>;
            label = "TXT_ASSIGNMENT";
        };

        txt_equals: txt_equals {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp EQUAL &kp SPACE>;
            label = "TXT_EQUALS";
        };

        txt_nequals: txt_nequals {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EXCL &kp EQUAL &kp SPACE>;
            label = "TXT_NEQUALS";
        };
    };

    combos {
        compatible = "zmk,combos";

        right_super {
            bindings = <&kp LGUI>;
            key-positions = <27 28>;
        };

        right_esc {
            bindings = <&kp ESC>;
            key-positions = <24 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q        &kp W            &kp E         &kp R              &kp T        &kp Y        &kp U              &kp I                &kp O            &kp P
                &hrm LGUI A  &hrm LEFT_ALT S  &hrm LCTRL D  &hrm LEFT_SHIFT F  &kp G        &kp H        &hrm LEFT_SHIFT J  &hrm LEFT_CONTROL K  &hrm LEFT_ALT L  &hrm LGUI SLASH
&sk LEFT_SHIFT  &kp Z        &kp X            &kp C         &kp V              &kp B        &kp N        &kp M              &kp COMMA            &kp DOT          &kp INTERNATIONAL_1  &sl 7
                                              &lt 5 ESC     &lt 1 SPACE        &lt 3 TAB    &lt 4 ENTER  &lt 2 BACKSPACE    &lt 6 DELETE
            >;
        };

        navigation {
            bindings = <
                &none               &none                  &none                        &none                &none    &os_focus_notification  &kp LC(MINUS)         &kp LC(LS(EQUAL))     &kp LC(EQUAL)        &kp LC(N0)
                &hrm LEFT_GUI HOME  &hrm LEFT_ALT PAGE_UP  &hrm LEFT_CONTROL PAGE_DOWN  &hrm LEFT_SHIFT END  &none    &kp LEFT_ARROW          &hrm LEFT_SHIFT DOWN  &hrm LEFT_CONTROL UP  &hrm LEFT_ALT RIGHT  &hrm LEFT_GUI PRINTSCREEN
&studio_unlock  &none               &none                  &none                        &none                &none    &kp CAPSLOCK            &kp F2                &kp F6                &kp F7               &kp F11                    &os_end_session
                                                           &none                        &none                &none    &none                   &kp K_MENU            &os_lock_screen
            >;
        };

        symbols {
            bindings = <
            &kp LS(BSLH)             &kp LS(DLLR)             &kp LS(LBRC)                        &kp LS(RBRC)                       &txt_assignment    &none  &none                  &none                      &none               &none
            &hrm LEFT_GUI AMPERSAND  &hrm LEFT_ALT LS(GRAVE)  &hrm LEFT_CONTROL LEFT_PARENTHESIS  &hrm LEFT_SHIFT RIGHT_PARENTHESIS  &kp LS(EXCL)       &none  &hrm LEFT_SHIFT EQUAL  &hrm LEFT_CONTROL PERCENT  &hrm LEFT_ALT HASH  &hrm LEFT_GUI ASTERISK
&caps_word  &kp LS(AT)               &kp LS(PLUS)             &kp LBKT                            &kp RBKT                           &kp BSLH           &none  &none                  &none                      &none               &none                   &none
                                                              &kp GRAVE                           &kp LS(UNDER)                      &kp MINUS          &none  &none                  &none
            >;
        };

        numbers {
            bindings = <
       &none                          &none                   &none                    &none                 &none    &kp DOLLAR   &kp NUMBER_1              &kp NUMBER_2                &kp NUMBER_3            &kp UNDER
       &hrm LEFT_GUI INTERNATIONAL_1  &hrm LEFT_ALT ASTERISK  &hrm LEFT_CONTROL MINUS  &hrm LEFT_SHIFT PLUS  &none    &kp PERCENT  &hrm LEFT_SHIFT NUMBER_4  &hrm LEFT_CONTROL NUMBER_5  &hrm LEFT_ALT NUMBER_6  &hrm LEFT_GUI DOT
&none  &none                          &none                   &none                    &none                 &none    &none        &kp NUMBER_7              &kp NUMBER_8                &kp NUMBER_9            &kp COMMA          &none
                                                              &none                    &none                 &none    &kp EQUAL    &kp NUMBER_0              &none
            >;
        };

        media {
            bindings = <
            &kp C_REWIND  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_FAST_FORWARD  &none           &none  &none  &none  &none  &none
            &kp C_PREV    &kp C_VOL_DN          &kp C_VOLUME_UP       &kp C_NEXT          &none           &none  &none  &none  &none  &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3        &bt BT_SEL 4    &none  &none  &none  &none  &none  &studio_unlock
                                                &kp C_STOP            &kp C_PLAY_PAUSE    &kp K_MUTE      &none  &none  &none
            >;
        };

        function {
            bindings = <
       &none         &none         &none             &none           &none    &none  &kp F1  &kp F2  &kp F3  &kp F10
       &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none    &none  &kp F4  &kp F5  &kp F6  &kp F11
&none  &none         &none         &none             &none           &none    &none  &kp F7  &kp F8  &kp F9  &kp F12  &none
                                   &none             &none           &none    &none  &none   &none
            >;
        };

        shortcuts {
            bindings = <
       &none             &none             &none             &none             &none    &none  &none  &none  &none  &none
       &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &none    &none  &none  &none  &none  &none
&none  &kp LG(NUMBER_5)  &kp LG(NUMBER_6)  &kp LG(NUMBER_7)  &kp LG(NUMBER_8)  &none    &none  &none  &none  &none  &none  &none
                                           &none             &none             &none    &none  &none  &none
            >;
        };

        accents {
            bindings = <
       &none         &none         &none     &none     &none    &none  &none     &none     &none         &none
       &kp LS(LBKT)  &kp LS(APOS)  &kp APOS  &kp LBKT  &none    &none  &kp LBKT  &kp APOS  &kp LS(APOS)  &kp LS(LBKT)
&none  &none         &none         &kp SEMI  &none     &none    &none  &none     &none     &none         &none         &none
                                   &none     &none     &none    &none  &none     &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
