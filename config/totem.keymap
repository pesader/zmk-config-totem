#include <locale/keys_pt_abnt2.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    flavor = "balanced";
    tapping-term-ms = <300>;
    quick-tap-ms = <250>;
    require-prior-idle-ms = <50>;
};

&sk { quick-release; };

/ {
    behaviors {
        shift_bspc_del: shift_bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_BSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        lt_bspc_r: lt_bspc_r {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BSPC_R";
            bindings = <&mo>, <&shift_bspc_del>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <10 11 12 13 21 22 23 24>;
        };

        hrm_l: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <31 9 19 30 8 18 29 7 17 28 6 16 27 5 15 26 37 36 35>;
        };

        hrm_r: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 34>;
        };

        hrm_l_hwu: homerow_mod_left_hwu {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_HWU";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <31 9 19 30 8 18 29 7 17 28 6 16 27 5 15 26 37 36 35>;
        };

        hrm_r_hwu: homerow_mod_right_hwu {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_HWU";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 34>;
        };
    };

    macros {
        os_focus_notification: os_dismiss_notification {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>;
            label = "OS_DISMISS_NOTIFICATION";
        };

        os_end_session: os_end_session {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(DELETE))>;
            label = "OS_END_SESSION";
        };

        os_lock_screen: os_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(BACKSPACE))>;
            label = "OS_LOCK_SCREEN";
        };

        txt_assignment: txt_assignment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_SPACE &kp PT_EQUAL &kp PT_SPACE>;
            label = "TXT_ASSIGNMENT";
        };

        txt_equals: txt_equals {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_SPACE &kp PT_EQUAL &kp PT_EQUAL &kp PT_SPACE>;
            label = "TXT_EQUALS";
        };

        txt_nequals: txt_nequals {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_SPACE &kp PT_EXCL &kp PT_EQUAL &kp PT_SPACE>;
            label = "TXT_NEQUALS";
        };
    };

    combos {
        compatible = "zmk,combos";

        left_super {
            bindings = <&kp LGUI>;
            key-positions = <12 13>;
        };

        right_esc {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q          &kp W              &kp E            &kp R                &kp T        &kp Y        &kp U                &kp I                  &kp O              &kp P
                &hrm_l LGUI A  &hrm_l LEFT_ALT S  &hrm_l LCTRL D   &hrm_l LEFT_SHIFT F  &kp G        &kp H        &hrm_r LEFT_SHIFT J  &hrm_r LEFT_CONTROL K  &hrm_r LEFT_ALT L  &hrm_r LGUI PT_SEMI
&sk LEFT_SHIFT  &kp Z          &kp X              &kp C            &kp V                &kp B        &kp N        &kp M                &kp COMMA              &kp DOT            &kp PT_FSLH          &sl 7
                                                  &lt 5 ESC        &lt 1 PT_SPACE       &lt 3 TAB    &lt 4 ENTER  &lt 2 BACKSPACE      &lt_bspc_r 6 0
            >;
        };

        navigation {
            bindings = <
                &none                 &none                    &none                          &none                  &none    &os_focus_notification  &kp LC(MINUS)           &kp LC(LS(EQUAL))       &kp LC(EQUAL)          &kp LC(N0)
                &hrm_l LEFT_GUI HOME  &hrm_l LEFT_ALT PAGE_UP  &hrm_l LEFT_CONTROL PAGE_DOWN  &hrm_l LEFT_SHIFT END  &none    &kp LEFT_ARROW          &hrm_r LEFT_SHIFT DOWN  &hrm_r LEFT_CONTROL UP  &hrm_r LEFT_ALT RIGHT  &hrm_r LEFT_GUI PRINTSCREEN
&studio_unlock  &none                 &none                    &none                          &none                  &none    &kp CAPSLOCK            &kp F2                  &kp F6                  &kp F7                 &kp F11                      &os_end_session
                                                               &none                          &none                  &none    &none                   &kp K_MENU              &os_lock_screen
            >;
        };

        symbols {
            bindings = <
            &kp PT_PIPE              &kp DLLR                &kp PT_LBRC                  &kp PT_RBRC                &txt_assignment    &none  &none                       &none                         &none                    &none
            &hrm_l LEFT_GUI AMPS     &hrm_l LEFT_ALT PT_DQT  &hrm_l LEFT_CONTROL LPAR     &hrm_l LEFT_SHIFT RPAR     &kp EXCL           &none  &hrm_r LEFT_SHIFT EQUAL     &hrm_r LEFT_CONTROL PRCNT     &hrm_r LEFT_ALT HASH     &hrm_r LEFT_GUI STAR
&caps_word  &kp AT                   &kp PLUS                &kp PT_LBKT                  &kp PT_RBKT                &kp PT_BSLH        &none  &none                       &none                         &none                    &none                  &none
                                                             &kp PT_SQT                   &kp UNDER                  &kp MINUS          &none  &none                       &none
            >;
        };

        numbers {
            bindings = <
       &none                    &none                    &none                       &none                      &none    &kp DLLR      &kp N1                   &kp N2                     &kp N3                 &kp UNDER
       &hrm_l LEFT_GUI PT_FSLH  &hrm_l LEFT_ALT STAR     &hrm_l LEFT_CONTROL MINUS   &hrm_l LEFT_SHIFT PLUS     &none    &kp PRCNT     &hrm_r LEFT_SHIFT N4     &hrm_r LEFT_CONTROL N5     &hrm_r LEFT_ALT N6     &hrm_r LEFT_GUI DOT
&none  &none                    &none                    &none                       &none                      &none    &none         &kp N7                   &kp N8                     &kp N9                 &kp COMMA             &none
                                                         &none                       &none                      &none    &kp EQUAL     &kp N0                   &none
            >;
        };

        media {
            bindings = <
            &kp C_REWIND  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_FAST_FORWARD  &none           &none  &none  &none  &none  &none
            &kp C_PREV    &kp C_VOL_DN          &kp C_VOLUME_UP       &kp C_NEXT          &none           &none  &none  &none  &none  &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3        &bt BT_SEL 4    &none  &none  &none  &none  &none  &studio_unlock
                                                &kp C_STOP            &kp C_PLAY_PAUSE    &kp K_MUTE      &none  &none  &none
            >;
        };

        function {
            bindings = <
       &none         &none         &none             &none           &none    &none  &kp F1  &kp F2  &kp F3  &kp F10
       &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none    &none  &kp F4  &kp F5  &kp F6  &kp F11
&none  &none         &none         &none             &none           &none    &none  &kp F7  &kp F8  &kp F9  &kp F12  &none
                                   &none             &none           &none    &none  &none   &none
            >;
        };

        shortcuts {
            bindings = <
       &none          &none          &none          &none          &none    &none  &none  &none  &none  &none
       &kp LG(N1)     &kp LG(N2)     &kp LG(N3)     &kp LG(N4)     &none    &none  &none  &none  &none  &none
&none  &kp LG(N5)     &kp LG(N6)     &kp LG(N7)     &kp LG(N8)     &none    &none  &none  &none  &none  &none  &none
                                     &none          &none          &none    &none  &none  &none
            >;
        };

        accents {
            bindings = <
       &none         &none         &none             &none         &none    &none  &none         &none         &none         &none
       &kp PT_GRAVE  &kp PT_CARET  &kp PT_TILDE      &kp PT_ACUTE  &none    &none  &kp PT_ACUTE  &kp PT_TILDE  &kp PT_CARET  &kp PT_GRAVE
&none  &none         &none         &kp PT_C_CEDILLA  &none         &none    &none  &none         &none         &none         &none         &none
                                   &none             &none         &none    &none  &none         &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
