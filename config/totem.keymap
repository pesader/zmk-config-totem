//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-unless-interrupted";
            retro-tap;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-unless-interrupted";
            retro-tap;
        };
    };

    macros {
        os_focus_notification: os_dismiss_notification {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>;
            label = "OS_DISMISS_NOTIFICATION";
        };

        os_end_session: os_end_session {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(DELETE))>;
            label = "OS_END_SESSION";
        };

        os_lock_screen: os_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(BACKSPACE))>;
            label = "OS_LOCK_SCREEN";
        };

        txt_assignment: txt_assignment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp SPACE>;
            label = "TXT_ASSIGNMENT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q        &kp W            &kp E         &kp R              &kp T        &kp Y        &kp U              &kp I         &kp O            &kp P
                &hml LGUI A  &hml LEFT_ALT S  &hml LCTRL D  &hml LEFT_SHIFT F  &kp G        &kp H        &hmr LEFT_SHIFT J  &hmr LCTRL K  &hmr LEFT_ALT L  &hmr LGUI SEMI
&sk LEFT_SHIFT  &kp Z        &kp X            &kp C         &kp V              &kp B        &kp N        &kp M              &kp COMMA     &kp DOT          &kp FSLH        &sl 7
                                              &lt 5 ESC     &lt 1 SPACE        &lt 3 TAB    &lt 4 ENTER  &lt 2 BACKSPACE    &lt 6 DELETE
            >;
        };

        navigation {
            bindings = <
       &none           &none                  &none                        &none                &none    &os_focus_notification  &kp LC(MINUS)   &kp LC(LS(EQUAL))  &kp LC(EQUAL)    &kp LC(N0)
       &hml HOME LGUI  &hml PAGE_UP LEFT_ALT  &hml PAGE_DOWN LEFT_CONTROL  &hml END LEFT_SHIFT  &none    &kp LEFT_ARROW          &kp DOWN_ARROW  &kp UP_ARROW       &kp RIGHT_ARROW  &kp PRINTSCREEN
&none  &none           &none                  &none                        &none                &none    &kp CAPSLOCK            &kp F2          &kp F6             &kp F7           &kp F11          &os_end_session
                                              &none                        &none                &none    &none                   &kp K_MENU      &os_lock_screen
            >;
        };

        symbols {
            bindings = <
            &kp LS(BSLH)  &kp LS(DLLR)  &kp LS(LBRC)  &kp LS(RBRC)   &txt_assignment    &none  &none                  &none                     &none                 &none
            &kp LS(AMPS)  &kp LS(DQT)   &kp LS(LPAR)  &kp LS(RPAR)   &kp LS(EXCL)       &none  &hmr LEFT_SHIFT EQUAL  &hmr LEFT_CONTROL LS(N5)  &hmr LEFT_ALT LS(N3)  &hmr LGUI LS(N8)
&caps_word  &kp LS(AT)    &kp LS(PLUS)  &kp LBKT      &kp RBKT       &kp BSLH           &none  &none                  &none                     &none                 &none             &none
                                        &kp SQT       &kp LS(UNDER)  &kp MINUS          &none  &none                  &none
            >;
        };

        numbers {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        media {
            bindings = <
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;
        };

        function {
            bindings = <
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;
        };

        shortcuts {
            bindings = <
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;
        };

        accents {
            bindings = <
       &none         &none         &none     &none     &none    &none  &none     &none     &none         &none
       &kp LS(LBKT)  &kp LS(APOS)  &kp APOS  &kp LBKT  &none    &none  &kp LBKT  &kp APOS  &kp LS(APOS)  &kp LS(LBKT)
&none  &none         &none         &none     &none     &none    &none  &none     &none     &none         &none         &none
                                   &none     &none     &none    &none  &none     &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
